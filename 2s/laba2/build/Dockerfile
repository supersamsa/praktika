# Используем официальный образ GCC
FROM gcc:latest

# Информация о создателе
LABEL maintainer="Student"
LABEL description="Лабораторная работа №2 - Битовые поля и операции"

# Устанавливаем рабочий каталог
WORKDIR /app

# Копируем все исходные файлы из родительской директории
COPY .. .

# Показываем содержимое для отладки
RUN echo "📁 Содержимое директории:" && ls -la

# Переходим в директорию build для компиляции
WORKDIR /app/build

# Компилируем программу
RUN echo "🔨 Компиляция программы..." && \
    make clean && \
    make all && \
    echo "✅ Компиляция завершена"

# Возвращаемся в корневую директорию
WORKDIR /app

# Проверяем что исполняемый файл создан
RUN test -f /app/build/lab2_program && \
    echo "✅ Исполняемый файл создан в /app/build/lab2_program" || \
    echo "❌ Исполняемый файл не найден"

# Копируем исполняемый файл в корневую директорию для удобства
RUN cp /app/build/lab2_program /app/lab2_program

# Запускаем программу по умолчанию
CMD ["./lab2_program"]